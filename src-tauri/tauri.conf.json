{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionBoard",
  "version": "0.2.2",
  "identifier": "com.nurullahyayan.sessionboard",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run vendor",
    "beforeDevCommand": { "script": "npm run vendor", "wait": true }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SessionBoard",
        "width": 380,
        "height": 760,
        "minWidth": 300,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4QzQ2NzJEQ0REODNBNTYKUldSV090ak5MV2ZFMkhEelRSQzNteWdLQkxLeVdxbmtVcUJYWGF3YTB2SXl4Yjh6QTRha0N5WlIK",
      "endpoints": [
        "https://github.com/NYAYAN/claude-session-board/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Nurullah YAYAN",
    "publisher": "Nurullah YAYAN",
    "shortDescription": "Claude Code oturum düzenleyici",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
